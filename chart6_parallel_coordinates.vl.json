{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "title": {
    "text": "Income does not translate equally into household outcomes",
    "subtitle": "2024 state profiles; poverty and Gini axes are inverted so higher = stronger outcome"
  },
  "data": {
    "url": "data/hies_parallel_2024.csv"
  },
  "params": [
    {
      "name": "hover",
      "select": {
        "type": "point",
        "fields": [
          "state"
        ],
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 22
    }
  },
  "encoding": {
    "x": {
      "field": "metric",
      "type": "ordinal",
      "sort": [
        "Mean income (RM)",
        "Mean expenditure (RM)",
        "Poverty (%)",
        "Gini"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0
      }
    },
    "y": {
      "field": "normalized",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          1
        ]
      },
      "axis": {
        "title": "Relative position (0\u20131)",
        "labels": false,
        "ticks": false
      }
    },
    "detail": {
      "field": "state"
    },
    "color": {
      "field": "income_mean",
      "type": "quantitative",
      "title": "Mean income (RM)",
      "scale": {
        "scheme": "goldred"
      }
    },
    "opacity": {
      "condition": {
        "param": "hover",
        "value": 1
      },
      "value": 0.28
    },
    "strokeWidth": {
      "condition": {
        "param": "hover",
        "value": 3
      },
      "value": 1.1
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State"
      },
      {
        "field": "metric",
        "title": "Metric"
      },
      {
        "field": "raw",
        "title": "Value",
        "format": ",.2f"
      }
    ]
  },
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f"
    },
    "title": {
      "font": "DM Serif Display",
      "fontSize": 20,
      "fontWeight": "normal",
      "color": "#2d2926",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleColor": "#766b63",
      "subtitleFontSize": 11
    }
  }
}