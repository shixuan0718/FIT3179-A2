{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 345,
  "title": {
    "text": "Malaysia buys from China but exports most to the United States",
    "subtitle": "Major 2025 apparel & footwear partners (USD million)"
  },
  "data": {
    "url": "data/trade_balance_2025.csv"
  },
  "transform": [
    {
      "fold": [
        "export_mil",
        "import_mil"
      ],
      "as": [
        "direction",
        "value"
      ]
    },
    {
      "calculate": "datum.direction === 'import_mil' ? -datum.value : datum.value",
      "as": "signed_value"
    },
    {
      "calculate": "datum.direction === 'import_mil' ? 'Imports' : 'Exports'",
      "as": "flow"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "partnerDesc",
      "type": "nominal",
      "sort": {
        "field": "total",
        "order": "descending"
      },
      "axis": {
        "title": null
      }
    },
    "x": {
      "field": "signed_value",
      "type": "quantitative",
      "title": "← Imports     USD million     Exports →",
      "axis": {
        "format": ",.0f",
        "labelExpr": "abs(datum.value)"
      }
    },
    "color": {
      "field": "flow",
      "type": "nominal",
      "scale": {
        "domain": [
          "Imports",
          "Exports"
        ],
        "range": [
          "#b66a3c",
          "#315c55"
        ]
      },
      "legend": {
        "orient": "top"
      }
    },
    "tooltip": [
      {
        "field": "partnerDesc",
        "title": "Partner"
      },
      {
        "field": "flow"
      },
      {
        "field": "value",
        "title": "USD million",
        "format": ",.0f"
      }
    ]
  },
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "labelFontSize": 10,
      "titleFontSize": 11
    },
    "title": {
      "font": "DM Serif Display",
      "fontSize": 18,
      "fontWeight": "normal",
      "color": "#2d2926",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleColor": "#766b63",
      "subtitleFontSize": 10,
      "offset": 8
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  }
}