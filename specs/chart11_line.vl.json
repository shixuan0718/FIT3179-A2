{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "title": {
    "text": "Clothing got cheaper relative to the rest of the basket",
    "subtitle": "Unweighted average of 16 state/territory CPI series, Jan 2010\u2013Aug 2026"
  },
  "data": {
    "url": "data/cpi_state_average.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%Y"
          }
        },
        "y": {
          "field": "index",
          "type": "quantitative",
          "title": "CPI index"
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": [
              "All-items CPI",
              "Clothing & footwear CPI"
            ],
            "range": [
              "#315c55",
              "#7a2430"
            ]
          },
          "legend": {
            "orient": "top"
          }
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "format": "%b %Y"
          },
          {
            "field": "series"
          },
          {
            "field": "index",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2026-08-01",
            "index": 134.375,
            "label": "All-items \u2248 134"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -6,
        "dy": -10,
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#315c55"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "index",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2026-08-01",
            "index": 89.825,
            "label": "Clothing \u2248 90"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -6,
        "dy": 12,
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#7a2430"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "index",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "labelFontSize": 10,
      "titleFontSize": 11
    },
    "title": {
      "font": "DM Serif Display",
      "fontSize": 18,
      "fontWeight": "normal",
      "color": "#2d2926",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleColor": "#766b63",
      "subtitleFontSize": 10,
      "offset": 8
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  }
}