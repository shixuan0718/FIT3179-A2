{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 310,
  "title": {
    "text": "Clothing price pressure differs across Malaysia",
    "subtitle": "Average year-on-year clothing & footwear inflation, Jan–Aug 2026"
  },
  "data": {
    "url": "data/state_clothing_inflation_2026.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 8,
        "stroke": "#fffaf4",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "tile_x",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "tile_y",
          "type": "ordinal",
          "axis": null,
          "sort": "descending"
        },
        "color": {
          "field": "inflation_yoy",
          "type": "quantitative",
          "title": "YoY %",
          "scale": {
            "domain": [
              -3.2,
              0,
              1.7
            ],
            "range": [
              "#2d6a9f",
              "#f6efe7",
              "#b21f35"
            ]
          },
          "legend": {
            "orient": "right",
            "gradientLength": 150
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "inflation_yoy",
            "title": "Avg YoY %",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 9,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "tile_x",
          "type": "ordinal"
        },
        "y": {
          "field": "tile_y",
          "type": "ordinal",
          "sort": "descending"
        },
        "text": {
          "field": "tile_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.inflation_yoy <= -2 || datum.inflation_yoy >= 1.2",
            "value": "#fffaf4"
          },
          "value": "#2d2926"
        }
      }
    }
  ],
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "labelFontSize": 10,
      "titleFontSize": 11
    },
    "title": {
      "font": "DM Serif Display",
      "fontSize": 18,
      "fontWeight": "normal",
      "color": "#2d2926",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleColor": "#766b63",
      "subtitleFontSize": 10,
      "offset": 8
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  }
}