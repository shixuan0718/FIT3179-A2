          },
          "axis": null,
          "field": "cy"
        },
        "text": {
          "field": "income_mean",
          "type": "quantitative",
          "format": ",.0f"
        },
        "color": {
          "condition": {
            "test": "datum.income_mean > 9000",
            "value": "#fffaf4"
          },
          "value": "#2d2926"
        }
      }
    },
