{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 310,
  "title": {
    "text": "A tile-grid reveals the affordability divide",
    "subtitle": "Poverty rate by state / federal territory, 2024"
  },
  "data": {
    "url": "data/state_context_2024.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 8,
        "stroke": "#fffaf4",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "tile_x",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "tile_y",
          "type": "ordinal",
          "axis": null,
          "sort": "descending"
        },
        "color": {
          "field": "poverty",
          "type": "quantitative",
          "title": "Poverty %",
          "scale": {
            "scheme": "orangered"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "poverty",
            "title": "Poverty %",
            "format": ".1f"
          },
          {
            "field": "income_mean",
            "title": "Mean income (RM)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 700,
        "color": "#2d2926"
      },
      "encoding": {
        "x": {
          "field": "tile_x",
          "type": "ordinal"
        },
        "y": {
          "field": "tile_y",
          "type": "ordinal",
          "sort": "descending"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    }
  ],
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "labelFontSize": 10,
      "titleFontSize": 11
    },
    "title": {
      "font": "DM Serif Display",
      "fontSize": 18,
      "fontWeight": "normal",
      "color": "#2d2926",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleColor": "#766b63",
      "subtitleFontSize": 10,
      "offset": 8
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  }
}
