        },
        {
          "calculate": "+datum.tile_x+0.46",
          "as": "cx"
        },
        {
          "calculate": "+datum.tile_y+0.46",
          "as": "cy"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "dy": 8
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
