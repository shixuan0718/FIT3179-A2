  "transform": [
    {
      "calculate": "datum.share_pct/100",
      "as": "share"
    },
    {
      "calculate": "format(datum.total_mil, ',.0f') + 'm'",
      "as": "total_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadius": 0
      },
      "encoding": {
        "x": {
          "field": "share",
          "type": "quantitative",
          "stack": "zero",
          "title": "Product mix of each supplier (%)",
          "axis": {
            "format": ".0%",
            "grid": true,
            "tickCount": 5,
            "titlePadding": 10,
            "labelFontSize": 11
          },
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Knitted apparel",
              "Woven apparel",
              "Footwear"
            ],
            "range": [
              "#7a2430",
              "#b66a3c",
              "#a8884a"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "supplier === '' || datum.partner === supplier",
            "value": 0.95
          },
          "value": 0.18
        },
        "tooltip": [
          {
            "field": "partner",
            "title": "Supplier"
          },
          {
            "field": "category",
            "title": "Product group"
          },
          {
            "field": "share_pct",
            "title": "Share of its imports (%)",
            "format": ".1f"
          },
          {
            "field": "category_mil",
            "title": "Value (US$ million)",
            "format": ",.1f"
          },
          {
            "field": "total_mil",
            "title": "Supplier total (US$ million)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "total_mil",
              "as": "total_mil"
            }
          ],
          "groupby": [
            "partner"
          ]
        },
        {
          "calculate": "'US$' + format(datum.total_mil, ',.0f') + 'm'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 10,
        "color": "#6e6257"
      },
      "encoding": {
        "x": {
          "datum": 1,
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "opacity": {
          "condition": {
            "test": "supplier === '' || datum.partner === supplier",
            "value": 1
          },
          "value": 0.28
        }
      }
    }
  ],
  "encoding": {
    "y": {
      "field": "partner",
      "type": "nominal",
      "sort": [
        "China",
        "Viet Nam",
        "Singapore",
        "Bangladesh",
        "Indonesia",
        "India",
        "Cambodia",
        "Italy"
      ],
      "title": null,
      "axis": {
        "labels": true,
        "ticks": false,
        "domain": false,
        "labelFontSize": 12,
        "labelFontWeight": 600,
        "labelColor": "#39332f",
        "labelLimit": 135,
        "labelPadding": 12
      }
    }
  },
  "padding": {
    "left": 5,
    "right": 65,
    "top": 8,
    "bottom": 6
