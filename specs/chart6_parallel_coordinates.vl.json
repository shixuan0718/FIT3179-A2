{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 6 (parallel coordinates): each line is one state across three scales, 2024 (OpenDOSM HIES). Each scale runs from the lowest to the highest state on that measure.",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "titleFontWeight": 600,
      "labelFontSize": 11,
      "titleFontSize": 11,
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600
    },
    "text": {
      "font": "Inter"
    }
  },
  "params": [
    {
      "name": "hl",
      "value": ""
    }
  ],
  "data": {
    "url": "data/hies_parallel_2024.csv"
  },
  "layer": [
    {
      "data": {
        "url": "data/hies_axes.csv"
      },
      "mark": {
        "type": "rule",
        "color": "#9a8f82",
        "strokeWidth": 1.6
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.55,
              2.55
            ]
          },
          "axis": null,
          "field": "order"
        },
        "y": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.16,
              1.2
            ]
          },
          "axis": null,
          "datum": 0
        },
        "y2": {
          "datum": 1
        }
      }
    },
    {
      "data": {
        "url": "data/hies_axes.csv"
      },
      "mark": {
        "type": "text",
        "fontWeight": 700,
        "fontSize": 12,
        "baseline": "bottom",
        "color": "#2d2926"
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.55,
              2.55
            ]
          },
          "axis": null,
