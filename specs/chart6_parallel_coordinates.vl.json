          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "stroke",
            "symbolStrokeWidth": 3
          }
        },
        "opacity": {
          "condition": {
            "test": "hl === '' || datum.state === hl",
            "value": 0.92
          },
          "value": 0.12
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "axis",
            "title": "Measure"
          },
          {
            "field": "raw",
            "title": "Value (RM or %)",
            "format": ",.1f"
          }
        ]
      }
    },
