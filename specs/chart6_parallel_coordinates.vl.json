{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Parallel coordinates comparing the 2025 HS 61/62/64 product shares within each of Malaysia’s eight biggest named clothing and footwear import suppliers; values from original UN Comtrade export file.",
  "width": "container",
  "height": 330,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "titleFontWeight": 600,
      "labelFontSize": 11,
      "titleFontSize": 11,
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600
    },
    "text": {
      "font": "Inter"
    }
  },
  "params": [
    {
      "name": "supplier",
      "value": ""
    }
  ],
  "data": {
    "url": "data/supplier_profiles_2025.csv"
  },
  "layer": [
    {
      "data": {
        "url": "data/supplier_profile_axes.csv"
      },
      "mark": {
        "type": "rule",
        "color": "#b9ada1",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "order",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.4,
              2.4
            ]
          },
          "axis": null
        },
        "y": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [
              -20,
              120
            ]
          },
          "axis": null
        },
        "y2": {
          "datum": 100
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 0,
            "y": 25
          },
          {
            "x": 0,
            "y": 50
          },
          {
            "x": 0,
            "y": 75
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#ede5dd",
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.4,
              2.4
            ]
          },
          "axis": null
        },
        "x2": {
          "datum": 2
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              -20,
              120
            ]
          },
          "axis": null
        }
      }
    },
    {
      "data": {
        "url": "data/supplier_profile_axes.csv"
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#2d2926",
        "baseline": "bottom"
      },
      "encoding": {
        "x": {
          "field": "order",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.4,
              2.4
            ]
          },
          "axis": null
        },
        "y": {
          "datum": 108,
          "type": "quantitative",
          "scale": {
            "domain": [
              -20,
              120
            ]
          },
          "axis": null
        },
        "text": {
          "field": "category"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 40
        },
        "strokeWidth": 2.7
      },
      "encoding": {
        "x": {
          "field": "order",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.4,
              2.4
            ]
          },
          "axis": null
        },
        "y": {
          "field": "share_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              -20,
              120
            ]
          },
          "axis": null
        },
        "detail": {
          "field": "partner",
          "type": "nominal"
        },
        "color": {
          "field": "dominant",
          "type": "nominal",
          "scale": {
            "domain": [
              "Knitted apparel",
              "Woven apparel",
              "Footwear"
            ],
            "range": [
              "#7a2430",
              "#b66a3c",
              "#a8884a"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Largest category for each supplier",
            "labelLimit": 145
          }
        },
        "opacity": {
          "condition": {
            "test": "supplier === '' || datum.partner === supplier",
            "value": 0.88
          },
          "value": 0.09
        },
        "tooltip": [
          {
            "field": "partner",
            "title": "Supplier"
          },
          {
            "field": "category",
            "title": "Product group"
          },
          {
            "field": "share_pct",
            "title": "Share of its imports (%)",
            "format": ".1f"
          },
          {
            "field": "category_mil",
            "title": "Value (US$ million)",
            "format": ",.1f"
          },
          {
            "field": "total_mil",
            "title": "All three product groups (US$ m)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "order": 0,
            "label": "0–100% = share of supplier imports"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "color": "#75695f",
        "baseline": "top"
      },
      "encoding": {
        "x": {
          "field": "order",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.4,
              2.4
            ]
          },
          "axis": null
        },
        "y": {
          "datum": -10,
          "type": "quantitative",
          "scale": {
            "domain": [
              -20,
              120
            ]
          },
          "axis": null
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
