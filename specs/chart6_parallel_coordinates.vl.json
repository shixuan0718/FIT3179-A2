{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "title": {
    "text": "Suppliers specialise in different fashion categories",
    "subtitle": "Top 8 suppliers, 2025 · category axes show each partner’s mix; volume is relative"
  },
  "data": {
    "url": "data/trade_partner_profiles_2025.csv"
  },
  "params": [
    {
      "name": "hover",
      "select": {
        "type": "point",
        "fields": [
          "partner"
        ],
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 24
    }
  },
  "encoding": {
    "x": {
      "field": "metric",
      "type": "ordinal",
      "sort": [
        "Knitted",
        "Woven",
        "Footwear",
        "Volume"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelFontSize": 10,
        "labelPadding": 8
      }
    },
    "y": {
      "field": "normalized",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          1
        ]
      },
      "axis": {
        "title": "Relative profile (0–1)",
        "labels": false,
        "ticks": false
      }
    },
    "detail": {
      "field": "partner"
    },
    "color": {
      "field": "total_mil",
      "type": "quantitative",
      "title": "Total imports (USD m)",
      "scale": {
        "scheme": "goldred"
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "gradientLength": 120,
        "title": "Total imports (USD m)"
      }
    },
    "opacity": {
      "condition": {
        "param": "hover",
        "value": 1
      },
      "value": 0.34
    },
    "strokeWidth": {
      "condition": {
        "param": "hover",
        "value": 3
      },
      "value": 1.2
    },
    "tooltip": [
      {
        "field": "partner",
        "title": "Supplier"
      },
      {
        "field": "metric",
        "title": "Axis"
      },
      {
        "field": "raw",
        "title": "Value",
        "format": ".1f"
      },
      {
        "field": "unit",
        "title": "Unit"
      }
    ]
  },
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "labelFontSize": 10,
      "titleFontSize": 11
    },
    "title": {
      "font": "DM Serif Display",
      "fontSize": 18,
      "fontWeight": "normal",
      "color": "#2d2926",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleColor": "#766b63",
      "subtitleFontSize": 10,
      "offset": 8
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  }
}