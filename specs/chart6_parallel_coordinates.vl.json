{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "title": {
    "text": [
      "Income does not guarantee",
      "stronger household outcomes"
    ],
    "subtitle": "2024 state profiles · poverty and Gini are inverted (higher = stronger)"
  },
  "data": {
    "url": "data/hies_parallel_2024.csv"
  },
  "params": [
    {
      "name": "hover",
      "select": {
        "type": "point",
        "fields": [
          "state"
        ],
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 22
    }
  },
  "encoding": {
    "x": {
      "field": "metric_short",
      "type": "ordinal",
      "sort": [
        "Income",
        "Spending",
        "Poverty",
        "Gini"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelFontSize": 10,
        "labelPadding": 8
      }
    },
    "y": {
      "field": "normalized",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          1
        ]
      },
      "axis": {
        "title": "Relative position (0–1)",
        "labels": false,
        "ticks": false
      }
    },
    "detail": {
      "field": "state"
    },
    "color": {
      "field": "income_mean",
      "type": "quantitative",
      "title": "Mean income (RM)",
      "scale": {
        "scheme": "goldred"
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "gradientLength": 120,
        "title": "Mean income (RM)"
      }
    },
    "opacity": {
      "condition": {
        "param": "hover",
        "value": 1
      },
      "value": 0.28
    },
    "strokeWidth": {
      "condition": {
        "param": "hover",
        "value": 3
      },
      "value": 1.1
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State"
      },
      {
        "field": "metric",
        "title": "Metric"
      },
      {
        "field": "raw",
        "title": "Value",
        "format": ",.2f"
      }
    ]
  },
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "labelFontSize": 10,
      "titleFontSize": 11
    },
    "title": {
      "font": "DM Serif Display",
      "fontSize": 18,
      "fontWeight": "normal",
      "color": "#2d2926",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleColor": "#766b63",
      "subtitleFontSize": 10,
      "offset": 8
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "transform": [
    {
      "calculate": "datum.metric === 'Mean income (RM)' ? 'Income' : datum.metric === 'Mean expenditure (RM)' ? 'Spending' : datum.metric === 'Poverty (%)' ? 'Poverty' : 'Gini'",
      "as": "metric_short"
    }
  ]
}
