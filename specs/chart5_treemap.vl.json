{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 370,
  "title": {
    "text": "China anchors the largest import blocks",
    "subtitle": "2025 imports by HS category and partner; rectangle area \u221d USD value"
  },
  "data": {
    "url": "data/trade_import_treemap_layout_2025.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fffaf4",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              1
            ],
            "reverse": true
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Knitted apparel",
              "Woven apparel",
              "Footwear"
            ],
            "range": [
              "#7a2430",
              "#b66a3c",
              "#c9a96e"
            ]
          },
          "legend": {
            "orient": "top"
          }
        },
        "tooltip": [
          {
            "field": "category"
          },
          {
            "field": "partner"
          },
          {
            "field": "value_mil",
            "title": "USD million",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.share_total > 0.018"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 6,
        "dy": 6,
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 700,
        "color": "#fffaf4"
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              1
            ],
            "reverse": true
          }
        },
        "text": {
          "field": "partner"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f"
    },
    "title": {
      "font": "DM Serif Display",
      "fontSize": 20,
      "fontWeight": "normal",
      "color": "#2d2926",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleColor": "#766b63",
      "subtitleFontSize": 11
    }
  }
}