{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "title": {
    "text": "Malaysia’s fashion product mix has shifted over time",
    "subtitle": "Imports by HS chapter, 2015–2025 · market availability proxy, USD billion"
  },
  "data": {
    "url": "data/trade_world_annual.csv"
  },
  "transform": [
    {
      "filter": "datum.flowDesc === 'Import'"
    }
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone",
    "opacity": 0.9
  },
  "encoding": {
    "x": {
      "field": "refYear",
      "type": "ordinal",
      "title": null
    },
    "y": {
      "field": "value_bil",
      "type": "quantitative",
      "stack": "center",
      "axis": null
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "scale": {
        "domain": [
          "Knitted apparel",
          "Woven apparel",
          "Footwear"
        ],
        "range": [
          "#7a2430",
          "#b66a3c",
          "#c9a96e"
        ]
      },
      "legend": {
        "orient": "top"
      }
    },
    "tooltip": [
      {
        "field": "refYear",
        "title": "Year"
      },
      {
        "field": "category"
      },
      {
        "field": "value_bil",
        "title": "USD bn",
        "format": ".2f"
      }
    ]
  },
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "labelFontSize": 10,
      "titleFontSize": 11
    },
    "title": {
      "font": "DM Serif Display",
      "fontSize": 18,
      "fontWeight": "normal",
      "color": "#2d2926",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleColor": "#766b63",
      "subtitleFontSize": 10,
      "offset": 8
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  }
}