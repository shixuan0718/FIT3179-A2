{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 350,
  "title": {
    "text": "Clothing inflation has cooled — but not evenly",
    "subtitle": "Average year-on-year clothing & footwear inflation by state, 2020–2026"
  },
  "data": {
    "url": "data/clothing_inflation_heatmap.csv"
  },
  "mark": {
    "type": "rect",
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": "-x"
    },
    "color": {
      "field": "inflation_yoy",
      "type": "quantitative",
      "title": "YoY %",
      "scale": {
        "scheme": "redblue",
        "domainMid": 0,
        "reverse": true
      }
    },
    "tooltip": [
      {
        "field": "state"
      },
      {
        "field": "year"
      },
      {
        "field": "inflation_yoy",
        "title": "Average YoY inflation %",
        "format": ".1f"
      }
    ]
  },
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7",
      "labelFontSize": 9
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "labelFontSize": 10,
      "titleFontSize": 11
    },
    "title": {
      "font": "DM Serif Display",
      "fontSize": 18,
      "fontWeight": "normal",
      "color": "#2d2926",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleColor": "#766b63",
      "subtitleFontSize": 10,
      "offset": 8
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  }
}
