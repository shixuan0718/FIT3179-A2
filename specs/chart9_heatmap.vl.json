          ]
        },
        "y": {
          "field": "year_label",
          "type": "ordinal",
          "sort": [
            "2020",
            "2021",
            "2022",
            "2023",
            "2024",
            "2025",
            "2026 (to Aug)"
          ]
        },
        "text": {
