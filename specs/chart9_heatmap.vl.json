          ]
        },
        "y": {
          "field": "year_label",
          "type": "ordinal",
          "sort": [
            "2020",
            "2021",
            "2022",
            "2023",
            "2024",
            "2025",
            "2026 (to Aug)"
          ]
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "month": "Dec",
            "year_label": "2024",
            "t": "falling again"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 22,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#6b625a"
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
