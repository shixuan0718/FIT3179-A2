{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "title": {
    "text": "Household spending power varies sharply by state",
    "subtitle": "Mean monthly household expenditure, 2024 (RM)"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/dosm-malaysia/data-open/main/datasets/geodata/administrative_1_state.geojson"
  },
  "transform": [
    {
      "lookup": "properties.state",
      "from": {
        "data": {
          "url": "data/state_context_2024.csv"
        },
        "key": "state",
        "fields": [
          "expenditure_mean",
          "income_mean",
          "poverty"
        ]
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "mark": {
    "type": "geoshape",
    "stroke": "#fffaf4",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "expenditure_mean",
      "type": "quantitative",
      "title": "RM / month",
      "scale": {
        "scheme": "redyellowblue",
        "reverse": true
      }
    },
    "tooltip": [
      {
        "field": "properties.state",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "expenditure_mean",
        "type": "quantitative",
        "title": "Mean expenditure",
        "format": ",.0f"
      },
      {
        "field": "income_mean",
        "type": "quantitative",
        "title": "Mean income",
        "format": ",.0f"
      },
      {
        "field": "poverty",
        "type": "quantitative",
        "title": "Poverty rate",
        "format": ".1f"
      }
    ]
  },
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f"
    },
    "title": {
      "font": "DM Serif Display",
      "fontSize": 20,
      "fontWeight": "normal",
      "color": "#2d2926",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleColor": "#766b63",
      "subtitleFontSize": 11
    }
  }
}