{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "title": {
    "text": "Household budgets vary sharply across Malaysia",
    "subtitle": "Mean monthly household expenditure by state / federal territory, 2024"
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/dosm-malaysia/data-open/main/datasets/geodata/administrative_1_state.geojson"
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1ebe4",
        "stroke": "#c8bdb2",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/state_context_2024.csv"
      },
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 260,
        "opacity": 0.92,
        "stroke": "#fffaf4",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "expenditure_mean",
          "type": "quantitative",
          "title": "RM / month",
          "scale": {
            "scheme": "orangered"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 180,
            "gradientThickness": 10,
            "title": "RM / month",
            "titleOrient": "left",
            "offset": 8
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "expenditure_mean",
            "type": "quantitative",
            "title": "Mean expenditure (RM)",
            "format": ",.0f"
          },
          {
            "field": "income_mean",
            "type": "quantitative",
            "title": "Mean income (RM)",
            "format": ",.0f"
          },
          {
            "field": "poverty",
            "type": "quantitative",
            "title": "Poverty rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_context_2024.csv"
      },
      "transform": [
        {
          "filter": "datum.state == 'W.P. Kuala Lumpur' || datum.state == 'W.P. Putrajaya' || datum.state == 'Sabah' || datum.state == 'Sarawak' || datum.state == 'Johor' || datum.state == 'Pulau Pinang'"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 9,
        "fontWeight": 700,
        "dy": -11,
        "color": "#2d2926"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "tile_label",
          "type": "nominal"
        }
      }
    }
  ],
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "labelFontSize": 10,
      "titleFontSize": 11
    },
    "title": {
      "font": "DM Serif Display",
      "fontSize": 18,
      "fontWeight": "normal",
      "color": "#2d2926",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleColor": "#766b63",
      "subtitleFontSize": 10,
      "offset": 8
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  }
}