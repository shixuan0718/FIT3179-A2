{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "title": {
    "text": "Import hotspots cluster across Asia",
    "subtitle": "Top 10 origins of Malaysia’s apparel & footwear imports, 2025"
  },
  "projection": {
    "type": "equalEarth",
    "center": [
      88,
      18
    ],
    "scale": 190
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eee7df",
        "stroke": "#d0c6bc",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/trade_partners_2025.csv"
      },
      "transform": [
        {
          "filter": "datum.flow === 'Import'"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.78,
        "color": "#b66a3c",
        "stroke": "#fffaf4",
        "strokeWidth": 1.3
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "value_mil",
          "type": "quantitative",
          "title": "Imports (USD m)",
          "scale": {
            "range": [
              30,
              1500
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Imports (USD million)",
            "symbolLimit": 4,
            "columns": 4,
            "offset": 8
          }
        },
        "tooltip": [
          {
            "field": "partnerDesc",
            "title": "Origin"
          },
          {
            "field": "value_mil",
            "title": "Imports (USD m)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/trade_partners_2025.csv"
      },
      "transform": [
        {
          "filter": "datum.flow === 'Import' && (datum.rank <= 5)"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 9,
        "fontWeight": 700,
        "dy": -13,
        "color": "#2d2926"
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        },
        "text": {
          "field": "partnerDesc"
        }
      }
    }
  ],
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "labelFontSize": 10,
      "titleFontSize": 11
    },
    "title": {
      "font": "DM Serif Display",
      "fontSize": 18,
      "fontWeight": "normal",
      "color": "#2d2926",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleColor": "#766b63",
      "subtitleFontSize": 10,
      "offset": 8
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  }
}