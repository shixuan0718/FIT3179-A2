{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Fashion-only proportional-symbol world map. Symbol area indicates 2025 apparel and footwear import value by the ten leading supplier countries, calculated from the supplied UN Comtrade HS 61/62/64 source. Symbol colour shows the largest HS chapter for each supplier.",
  "width": "container",
  "height": 500,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "titleFontWeight": 600,
      "labelFontSize": 11,
      "titleFontSize": 11,
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600
    },
    "text": {
      "font": "Inter"
    }
  },
  "params": [
    {
      "name": "supplier",
      "value": ""
    }
  ],
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -100,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "geo/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name !== 'Antarctica'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#f1ebe4",
        "stroke": "#d8cec4",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/top_import_suppliers_2025.csv"
      },
      "mark": {
        "type": "circle",
        "stroke": "#fffaf4",
        "strokeWidth": 1.7,
        "opacity": 0.88
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "dominant",
          "type": "nominal",
          "scale": {
            "domain": [
              "Knitted apparel",
              "Woven apparel",
              "Footwear"
            ],
            "range": [
              "#7a2430",
              "#b66a3c",
              "#a8884a"
            ]
          },
          "legend": {
            "title": "Largest fashion product group",
            "orient": "bottom",
            "direction": "horizontal",
            "labelLimit": 165,
            "symbolSize": 160
          }
        },
        "size": {
          "field": "total_mil",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              1200
            ],
            "range": [
              25,
              1700
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Imports to Malaysia (US$ million, 2025)",
            "values": [
              100,
              400,
              1000
            ],
            "symbolFillColor": "#b66a3c",
            "symbolOpacity": 0.85,
            "titleLimit": 340
          }
        },
        "opacity": {
          "condition": {
            "test": "supplier === '' || datum.partner === supplier",
            "value": 0.9
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "partner",
            "title": "2025 supplier"
          },
          {
            "field": "total_mil",
            "title": "Total imports (US$ million)",
            "format": ",.1f"
          },
          {
            "field": "dominant",
            "title": "Largest category"
          },
          {
            "field": "share_pct",
            "title": "Share of supplier imports (%)",
            "format": ".1f"
          },
          {
            "field": "knitted_mil",
            "title": "Knitted apparel (US$ m)",
            "format": ",.1f"
          },
          {
            "field": "woven_mil",
            "title": "Woven apparel (US$ m)",
            "format": ",.1f"
          },
          {
            "field": "footwear_mil",
            "title": "Footwear (US$ m)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/top_import_suppliers_2025.csv"
      },
      "transform": [
        {
          "filter": "datum.partner === 'China' || datum.partner === 'Bangladesh' || datum.partner === 'Viet Nam'"
        }
      ],
      "mark": {
        "type": "text",
        "fontWeight": 700,
        "fontSize": 12,
        "dx": 12,
        "dy": -13,
        "color": "#2d2926"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "partner"
        }
      }
    }
  ]
}