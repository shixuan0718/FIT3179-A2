{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "title": {
    "text": "Manufacturing output clusters in the west",
    "subtitle": "Real manufacturing GDP by state, 2025 · context only"
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/dosm-malaysia/data-open/main/datasets/geodata/administrative_1_state.geojson"
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1ebe4",
        "stroke": "#c8bdb2",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "data/manufacturing_2025.csv"
      },
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.78,
        "color": "#b66a3c",
        "stroke": "#fffaf4",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        },
        "size": {
          "field": "value_bil",
          "type": "quantitative",
          "title": "RM billion",
          "scale": {
            "range": [
              20,
              1300
            ]
          },
          "legend": {
            "orient": "right",
            "title": "RM bn",
            "symbolLimit": 5
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "value_bil",
            "title": "Manufacturing GDP (RM bn)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "gridColor": "#e9e1d8",
      "domainColor": "#bcb1a7",
      "tickColor": "#bcb1a7"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#39332f",
      "titleColor": "#39332f",
      "labelFontSize": 10,
      "titleFontSize": 11
    },
    "title": {
      "font": "DM Serif Display",
      "fontSize": 18,
      "fontWeight": "normal",
      "color": "#2d2926",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleColor": "#766b63",
      "subtitleFontSize": 10,
      "offset": 8
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  }
}
